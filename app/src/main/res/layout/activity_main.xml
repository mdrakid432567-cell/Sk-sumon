<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_mesh">

    <!-- Red Screen Tint Overlay -->
    <View
        android:id="@+id/redOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/accent_red"
        android:alpha="0.0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- TOP BAR -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="36dp"
            android:paddingBottom="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- LEFT: Battery, RAM & MYRA Branding -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/batteryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85% BAT"
                        android:textColor="@color/accent_red"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/ramText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.2GB RAM"
                        android:textColor="@color/text_hint"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:letterSpacing="-0.02"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MYRA"
                    android:textColor="@color/accent_red"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.25"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/subTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI COMPANION"
                    android:textColor="@color/text_hint"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"
                    android:layout_marginTop="-2dp" />
            </LinearLayout>

            <!-- RIGHT: Time & Settings Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end|center_vertical">

                <TextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:45 PM"
                    android:textColor="@color/accent_red"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/settingsBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_settings_button"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="Settings"
                    android:scaleType="centerInside"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CENTER AREA: Orb + Waveform + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <com.myra.assistant.ui.main.OrbAnimationView
                android:id="@+id/orbView"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center" />

            <com.myra.assistant.ui.main.WaveformView
                android:id="@+id/waveformView"
                android:layout_width="200dp"
                android:layout_height="32dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap karke bolo 💬"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- BOTTOM AREA: Chat + Mic -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <!-- Chat Messages Recycler -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatRecycler"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <!-- Text Prompt Input Row -->
            <LinearLayout
                android:id="@+id/inputRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/textInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="Type a command or message..."
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:inputType="textCapSentences"
                    android:imeOptions="actionSend" />

                <ImageButton
                    android:id="@+id/sendBtn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_settings_button"
                    android:src="@drawable/ic_send"
                    android:contentDescription="Send text"
                    android:scaleType="centerInside" />
            </LinearLayout>

            <!-- Mic Button (80dp Oval with Red Border & Shadow) -->
            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_mic_button"
                android:src="@drawable/ic_mic_off"
                android:contentDescription="Microphone"
                android:scaleType="centerInside"
                android:elevation="6dp" />

            <!-- Hint text (Uppercase tracking) -->
            <TextView
                android:id="@+id/hintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LONG PRESS TO STOP • TAP TO MUTE"
                android:textColor="@color/text_hint"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.2"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
